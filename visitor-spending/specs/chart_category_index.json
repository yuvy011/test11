{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 600,
  "height": 340,
  "config": {
    "background": "transparent",
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "domain": false,
      "gridColor": "#e3edf2",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": "normal",
      "labelLimit": 150,
      "tickCount": 5
    },
    "legend": {
      "orient": "bottom",
      "title": null,
      "columns": 2,
      "labelFontSize": 11
    }
  },
  "data": {
    "url": "data/category-history.json"
  },
  "params": [
    {
      "name": "categoryPick",
      "select": {
        "type": "point",
        "fields": [
          "category"
        ]
      },
      "bind": "legend"
    }
  ],
  "mark": {
    "type": "line",
    "point": {
      "filled": true,
      "size": 55
    },
    "strokeWidth": 2.5
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "title": "Annual period to March",
      "axis": {
        "labelAngle": 0
      }
    },
    "y": {
      "field": "index",
      "type": "quantitative",
      "title": "2024 = 100",
      "scale": {
        "domain": [
          0,
          200
        ]
      }
    },
    "color": {
      "field": "category",
      "type": "nominal",
      "title": null,
      "scale": {
        "domain": [
          "Food, drink & stay",
          "Transport",
          "Tours",
          "Shopping",
          "Entertainment",
          "Education",
          "Other"
        ],
        "range": [
          "#07566a",
          "#178da3",
          "#57b9c9",
          "#315f83",
          "#78cbd4",
          "#467e9b",
          "#9fb7c5"
        ]
      },
      "legend": {
        "columns": 2
      }
    },
    "opacity": {
      "condition": {
        "param": "categoryPick",
        "value": 1
      },
      "value": 0.1
    },
    "tooltip": [
      {
        "field": "category",
        "type": "nominal",
        "title": "Category"
      },
      {
        "field": "year",
        "type": "ordinal",
        "title": "Annual period to March"
      },
      {
        "field": "index",
        "type": "quantitative",
        "title": "Index (2024 = 100)",
        "format": ".1f"
      },
      {
        "field": "spend_b",
        "type": "quantitative",
        "title": "A$ billion",
        "format": ".2f"
      }
    ]
  }
}
